let misiAktif = 0;
let selesai = [false,false,false,false,false,false];

const meja = document.getElementById('meja');
meja.innerHTML = MISI.map((m, i) => `
  <div class="kartu" id="kartu-${i}" onclick="buka(${i})">
    <img src="${m.gambar}">
    <h3>${m.judul}</h3>
    <p>Klik untuk buka</p>
  </div>
`).join('');

function buka(i) {
  misiAktif = i;
  document.getElementById('popup').classList.remove('hidden');
  document.getElementById('popup-img').src = MISI[i].gambar;
  document.getElementById('popup-judul').innerText = MISI[i].judul;
  document.getElementById('popup-soal').innerText = MISI[i].soal;
  document.getElementById('jawaban').value = '';
  document.getElementById('hasil').innerText = '';
}

function tutup() {
  document.getElementById('popup').classList.add('hidden');
}

function cekJawaban() {
  const jawab = document.getElementById('jawaban').value.toLowerCase().trim();
  const benar = MISI[misiAktif].jawaban.toLowerCase().trim();
  if (jawab === benar) {
    document.getElementById('hasil').innerText = "✅ BENAR! Misi selesai!";
    selesai[misiAktif] = true;
    document.getElementById(`kartu-${misiAktif}`).classList.add('selesai');
    updateSkor();
    setTimeout(tutup, 1000);
  } else {
    document.getElementById('hasil').innerText = "❌ Salah, coba lagi!";
  }
}

function updateSkor() {
  const total = selesai.filter(x => x).length;
  document.getElementById('skor').innerText = `${total} / 6`;
  if (total === 6) alert('GG! Semua 6 misi selesai! Kamu penyelamat sejati!');
                }
